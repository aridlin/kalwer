<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_search" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp"
    android:background="@drawable/widget_background" android:contentDescription="@string/widget_search">
    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_kalwer" android:contentDescription="@null" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:text="@string/widget_search" android:textColor="#8ce9b3"
        android:textSize="16sp" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
